# Server-only secrets. Copy to server/.env and configure on the backend host.
# Never put these values in frontend VITE_ variables or commit the real file.
PORT=3001
# Use development only on a local/test server; production requires explicit CORS origins.
NODE_ENV=production
SUPABASE_URL=https://jrfmgqccicrpdtqztrpt.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated exact HTTPS frontend origins, e.g. https://www.example.com
CORS_ALLOWED_ORIGINS=
# Set only to the exact number of trusted reverse-proxy hops, if applicable.
TRUST_PROXY_HOPS=0
# Start with Razorpay test-mode keys. Live keys require explicit opt-in.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false
# Configure an SMTP sender on this server; the Arena Gmail connection is not a website mail service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFICATION_EMAIL=sultham456@gmail.com
