# Public frontend configuration: every VITE_ value is visible in the browser.
# Use /api when your frontend host proxies /api to the Express backend. For a
# separate API domain use its public HTTPS URL ending in /api; never localhost.
VITE_API_BASE_URL=/api
# Supabase publishable (or legacy anon) key, used ONLY for Auth through Express.
# NEVER put a secret key, service_role key or payment secret in this file.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional public Cloudflare Turnstile site key; configure the matching secret
# and provider in Supabase Auth before enabling it here.
VITE_TURNSTILE_SITE_KEY=
# Local Vite server only (not a browser URL): uncomment if the Express API is
# listening at a different location. Production uses your host's reverse proxy.
# DEV_API_PROXY_TARGET=http://127.0.0.1:3001
