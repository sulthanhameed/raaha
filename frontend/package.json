{
  "name": "raaha-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:cutouts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:backend": "playwright test --config playwright.backend.config.ts",
    "test:captcha": "playwright test --config playwright.captcha.config.ts",
    "test:db": "node --test scripts/test-supabase.mjs scripts/test-orders-payments.mjs",
    "test:server": "npm --prefix server test",
    "package:hosting": "sh scripts/package-hosting.sh",
    "check:cutouts": "node scripts/check-cutouts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "2.3.0"
  },
  "description": "Raaha restaurant frontend: React + Vite + Tailwind, REST client of the Express backend."
}
