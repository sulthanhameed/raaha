{
  "name": "raaha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo orchestrator for the Raaha restaurant project: frontend/, backend/ and database/ packages.",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "typecheck": "npm --prefix frontend run typecheck",
    "check:cutouts": "npm --prefix frontend run check:cutouts",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:backend": "npm --prefix frontend run test:backend",
    "test:captcha": "npm --prefix frontend run test:captcha",
    "test:server": "npm --prefix backend run test",
    "test:db": "npm --prefix database run test",
    "package:hosting": "sh scripts/package-hosting.sh",
    "install:all": "npm --prefix frontend ci && npm --prefix backend ci && npm --prefix database ci"
  }
}
